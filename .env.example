# Скопируйте в .env и заполните своими значениями. Сам .env в git не попадает.

# База данных
PLATES_HOST=localhost
PLATES_PORT=5433
PLATES_USER=<db_user>
PLATES_PASSWORD=<db_password>
PLATES_DATABASE=postgres
PLATES_SCHEMA=plates

# Подпись JWT: длинная случайная строка, например `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=<random_secret>

# Учётные данные для POST /auth/token
AUTH_USERNAME=<username>
AUTH_PASSWORD=<password>

PORT=8080
